  <widget class="QPushButton" name="pushButton">
   <property name="geometry">
    <rect>
     <x>200</x>
     <y>180</y>
     <width>101</width>
     <height>41</height>
    </rect>
   </property>
   <property name="styleSheet">
    <string notr="true">/* ====================
   串口按钮 - 默认状态
   ==================== */
QPushButton#pushButton_SerialPortOpen {
    color: rgb(0, 0, 0);
    background: rgb(255, 255, 255);
    border: 1px solid #9e9e9e;          /* 中灰色边框 */
    border-radius: 8px;
    padding: 5px 15px;                  /* 内边距，让按钮更舒适 */
    min-width: 80px;                    /* 最小宽度，防止按钮太小 */
    min-height: 30px;                   /* 最小高度 */
}

/* ====================
   鼠标悬停状态
   ==================== */
QPushButton#pushButton_SerialPortOpen:hover {
    background: rgb(220, 220, 220);
    border-color: rgb(0, 0, 0);
}

/* ====================
   鼠标按下状态
   ==================== */
QPushButton#pushButton_SerialPortOpen:pressed {
    background: rgb(190, 190, 190);
    border-color: rgb(0, 0, 0);
}

/* ====================
   禁用状态（灰色不可用）
   ==================== */
QPushButton#pushButton_SerialPortOpen:disabled {
    color: rgb(255, 255, 255);
    background: rgb(167, 164, 170);
    border-color: rgb(167, 164, 170);
}</string>
   </property>
   <property name="text">
    <string>连接</string>
